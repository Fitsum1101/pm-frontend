# API base URL. In dev, leave as "/api" so Vite's proxy forwards to the
# Express gateway (http://localhost:3000) and you avoid CORS.
# In production, set this to the gateway's public URL, e.g. https://api.example.com/api
VITE_API_BASE_URL=http://localhost:3000/api/v1

# App display name
VITE_APP_NAME=Express Auth Web
